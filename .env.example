# ---------------------------------------------
# Reto Backend GEEST - variables de entorno
# Copia este archivo como .env y ajusta valores
# ---------------------------------------------

# Puerto donde escucha la API
PORT=3000

# Entorno de ejecucion: development | test | production
NODE_ENV=development

# Cadena de conexion a PostgreSQL
# Coincide con docker-compose.yml (puerto 5436 en el host)
DATABASE_URL=postgres://geest:geest@localhost:5436/geest

# Usar SSL contra Postgres (true en proveedores cloud tipo Neon/Render/Heroku)
DATABASE_SSL=false

# Webhook externo al que se notifican los cambios de estado
NOTIFY_URL=https://webhook.site/00000000-0000-0000-0000-000000000000

# Clave que exigen todos los endpoints de negocio (header x-api-key).
# Este valor de desarrollo funciona tal cual: permite correr la API y los
# tests sin configuracion adicional.
# En produccion debe ser una cadena aleatoria fuerte y distinta de esta,
# generada por ejemplo con: openssl rand -hex 32
API_KEY=geest-dev-local-key
