# Configuracion usada por la suite de tests (npm test).
# Se versiona a proposito: no contiene secretos y hace que los tests
# corran sin configuracion adicional tras clonar el repositorio.

NODE_ENV=test

# Base de datos aparte, en el mismo contenedor de docker compose.
# La suite la recrea desde cero en cada ejecucion.
DATABASE_URL=postgres://geest:geest@localhost:5436/geest_test
DATABASE_SSL=false

# Servidor de notificaciones que la propia suite levanta.
NOTIFY_URL=http://127.0.0.1:4599/notify

API_KEY=geest-test-key
